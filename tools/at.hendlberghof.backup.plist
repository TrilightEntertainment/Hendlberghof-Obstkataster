<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>at.hendlberghof.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/test/Hendlberghof/github-pages/tools/backup_lokal.sh</string>
    </array>

    <!-- Am 1. jedes Monats um 09:00. War der Mac aus, holt macOS den Lauf nach. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/test/Hendlberghof-Backups/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/test/Hendlberghof-Backups/launchd.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
