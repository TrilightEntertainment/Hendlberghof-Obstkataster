rules_version = '2';

/* Hendlberghof Obstdatenbank — Zugriffsregeln
   Stand 11. 11. 2026: NUR NOCH LESEN.

   Seit dem Umzug (v149) liegen die Daten am eigenen Server (Hofbuch-Schnittstelle
   bei World4You). Firebase bleibt eine Woche als Rückweg lesbar, geschrieben wird
   hier nichts mehr; danach wird das Projekt gelöscht.
   Fassung davor (getrennte Dokumente, Schreiben angemeldet): Git-Verlauf. */

service cloud.firestore {
  match /databases/{database}/documents {
    match /app_state/main {
      allow read: if true;
      allow write: if false;
    }
    match /app_state/{dokument} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
